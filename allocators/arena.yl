type arena
[
	(natural[]) B
	inherit (allocator)
]
{
	(natural[]) next_free
	(byte array[B]) store

	algorithm ctor
	[
		/* */
	]
	{
		return /* */
	}

	algorithm reset
	(
		(THIS) this
	)
	{
		this.next_free = 0
	}

	algorithm free_space
	[
		return (natural[])
	]
	(
		(THIS) this
	)
	{
		return B - this.next_free
	}



	algorithm deallocate
	(
		(THIS) this
		(byte pointer |> immutable) p
	)
	{
	}

	algorithm allocate
	[
		return (byte pointer)
	]
	(
		(THIS) this
		(natural[] |> immutable) s
	)
	{
		if (s > this.free_space())
			return NULL;
		
		byte pointer ret = &this.store[this.next_free];
		this.next_free += s;
		return ret;
	}
}

