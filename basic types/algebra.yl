type monoid
{
	algorithm add
	associative
	[
		return (THIS)
	]
	(
		(THIS) a
		(THIS) b
	)
}

type group
[
	inherit (monoid)
]
{
	algorithm negate
	[
		return (THIS)
	]
	(
		(THIS) a
	)
	
	algorithm subtract
	(
		(THIS) a
		(THIS) b
	)
	{
		return b.negate() |> a.add
	}
}

type ring
[
	inherit (group)
]
{
	algorithm multiply
	associative
	[
		return (THIS)
	]
	(
		(THIS) a
		(THIS) b
	)

	algorithm invert
	[
		return (THIS)
	]
	(
		(THIS nonzero) a
	)

	algorithm divide
	(
		(THIS) a
		(THIS nonzero) b
	)
	{
		return b.invert() |> a.multiply
	}
}

type field
[
	inherit (group)
]
{
	algorithm multiply
	associative
	[
		return (THIS)
	]
	(
		(THIS) a
		(THIS) b
	)

	algorithm invert
	[
		return (THIS)
	]
	(
		(THIS) a
	)

	algorithm divide
	(
		(THIS) a
		(THIS) b
	)
	{
		return b.invert() |> a.multiply
	}
}

//algebras



type well-ordered
{
	algorithm is-less-than
	[
		return (boole)
	]
	(
		(THIS) a
		(THIS) b
	)

	algorithm is-greater-than
	[
		return (boole)
	]
	(
		(THIS) a
		(THIS) b
	)

	algorithm is-equal-to
	[
		return (boole)
	]
	(
		(THIS) a
		(THIS) b
	)

	algorithm compare
	[
		return (comparison)
	]
	(
		(THIS) a
		(THIS) b
	)
}

type ordering
[
	inherit (well-ordered)
]
{
	algorithm succ
	[
		return (THIS)
	]
	(
		(THIS) this
	)
}
