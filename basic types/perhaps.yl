type perhaps
[
	inherit (sdt)
]
(
	(type) t
)
{
	(boole) exists
	(t) data

	/***
	ctor() { this.exists = F; }
	ctor(t data) { this = {T, data}; }
	***/

	algorithm there
	[
		return (boole)
	]
	(
		(THIS) this
	)
	{
		return this.exists
	}

	algorithm map
	[
		(type) output
		return (output perhaps)
	]
	(
		(THIS) this
		(output << t) proc
	)
	{
		if (this.exists)
			return dt#1 perhaps(proc(this.data));
		else
			return dt#1 perhaps();
	}

	algorithm bind
	[
		(type) output
		return (output perhaps)
	]
	(
		(THIS) this
		(output perhaps << t) proc
	)
	{
		if (this.exists)
			return proc(this.data);
		else
			return dt#1 perhaps();
	}
	
	//convention for ensuring invariants: err when invariant is broken (can be optimized away when checked beforehand)
	algorithm dereference
	[
		return (t alias)
	]
	{
		if (~this.exists)
			err "Perhaps type did not contain a value";
		
		return this.data;
	}

	algorithm match
	[
		(type) output
		return (output perhaps)
	]
	(
		(THIS) this
		(output) default
		(output perhaps << t) proc
	)
	{
		if (this.exists)
			return proc(this.data);
		else
			return default;
	}

	algorithm get_pointer
	[
		return (t pointer)
	]
	(
		(THIS) this
	)
	{
		return ternary{this.exists, &this.data, NULL};
	}
}
