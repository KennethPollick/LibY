type bit_pointer
[
	inherit (sdt)
]
{
	(flags[] pointer) p
	(natural[1]) place

	/***
	ctor(flags[] immutable pointer p, immutable natural[1] place) { this = {p, place % 8}; }
	***/

	algorithm exists
	[
		return (boole)
	]
	(
		(THIS) this
	)
	{
		return this.p ~= NULL
	}

	algorithm dereference	//use safety pattern here
	[
		return (boole)
	]
	(
		(THIS) this
	)
	{
		return this.p[this.place]
	}

	algorithm set
	(
		(THIS) this
	)
	{
		this.p[this.place] = T
	}

	algorithm reset
	(
		(THIS) this
	)
	{
		this.p[this.place] = F
	}

	//toggle
}



(constant natural[]) R_BIT_ARRAY_DEFAULT_LENGTH = 8
type r_bit_array
[
	inherit (sdt)
]
{
	(flags pointer) arr	//DONE: fixed ambiguity of types with default size abstraction
	(natural[]) len

	/***
	ctor() { this = ctor(R_BIT_ARRAY_DEFAULT_LENGTH); }

	ctor(immutable natural[] bytes)
	{
		this = {allocate{flags[bytes]}, bytes};
	}
	***/

	algorithm length
	[
		return (natural)
	]
	(
		(THIS) this
	)
	{
		return this.len
	}

	algorithm capacity
	[
		return (natural)
	]
	(
		(THIS) this
	)
	{
		return size{*this.arr}
	}

	algorithm index
	[
		return (boole alias)
	]
	(
		(THIS) this
		(immutable natural[]) b
	)
	{
		return this.arr[b]
	}

	//TODO: finalize the full division hyperexpression keyword (rem) and probably make '&' for flags and boole
	algorithm pointer_to
	[
		return (bit_pointer)
	]
	(
		(THIS) this
		(immutable natural[]) b
	)
	{
		natural[] q;
		natural[] r = rem { q = b/8 };	//TODO: make list of hyperexpressions so shifts can be used here
		return bit_pointer{cast{&this.arr[q], flags pointer}, r}
	}

	//TODO: finish r_array and this
}



type bit_arena
[
	(natural[]) B
	inherit (sdt)
]
{
	(flags[B]) store
	(natural[]) next_free

	/***
	ctor() { this.reset(); }
	***/

	algorithm reset
	(
		(THIS) this
	)
	{
		this.next_free = 0
	}

	algorithm alloc
	[
		return (bit_pointer)
	]
	(
		(THIS) this
	)
	{
		if (this.next_free < B*8)
		{
			natural[] q;
			natural[] r = rem { q = this.next_free/8 };
			bit_pointer ret = {(&this.store) + q, r};
			this.next_free++;
			return ret;
		}
		
		return bit_pointer{};
	}
}
