//needs evaluation
//TODO: check whether deprecation is needed for c_array
type c_array
[
	inherit (ndt)
]
{
	(memory pointer) heap
	(t pointer r_array) indeces
	
	/***
	ctor()
	{
		
	}
	
	dtor()
	{
		free{heap};
		free{indeces};
	}
	***/

	algorithm index
	[
		return (t)
	]
	(
		(THIS) this
		(natural) i
	)
	{
		return cast{dt#0, (heap + indeces[index])}
	}
}
