algorithm X
[
	(type) t
	return (t)
]
(
	(t) x
)
{
	return x
}



algorithm K
[
	(type) t
	return (t)
]
(
	(t) x
	(t) y
)
{
	return x
}



algorithm Ki
[
	(type) t
	return (t)
]
(
	(t) x
	(t) y
)
{
	return y
}



algorithm ess
[
	(type) input
	(type) output
	(type) intermediary
	return (output)
]
(
	(input) x
	(output << (input, intermediary)) f
	(intermediary << input) g
)
{
	return f(x, g(x))
}

algorithm S
[
	(type) input
	(type) output
	(type) intermediary
	return (output << input)
]
(
	(output << (input, intermediary)) f
	(intermediary << input) g
)
{
	return ess(-, f, g)
}



algorithm B
[
	(type) i
	(type) m
	(type) o
	return (o << i)
]
(
	(o << m) f
	(m << i) g
)
{
	return f<>g
}



algorithm see
[
	(type) input
	(type) output
	return (output)
]
(
	(output << (input, input)) f
	(input) x
	(input) y
)
{
	return f(y, x)
}

algorithm C
[
	(type) input
	(type) output
	return (output << (input, input))
]
(
	(output << (input, input)) f
)
{
	return see(f, -, -)
}



algorithm dub
[
	(type) input
	(type) output
	return (output)
]
(
	(input) x
	(output << (input, input)) f
)
{
	return f(x, x)
}

algorithm W
[
	(type) input
	(type) output
	return (output << input)
]
(
	(output << (input, input)) f
)
{
	return dub(-, f)
}



algorithm dee
[
	(type) left-input
	(type) right-input
	(type) intermediary
	(type) output
	return (output)
]
(
	(output << (left-input, intermediary)) f
	(intermediary << right-input) g
	(left-input) x
	(right-input) y
)
{
	return f(x, g(y))
}

algorithm D
[
	(type) left-input
	(type) right-input
	(type) intermediary
	(type) output
	return (output << input)
]
(
	(output << (left-input, intermediary)) f
	(intermediary << right-input) g
)
{
	return dee(f, g, -, -)
}



algorithm B1
[
	(type) i
	(type) m
	(type) o
	return (o << (i, i))
]
(
	(o << m) f
	(m << (i, i)) g
)
{
	return f<>g
}



algorithm sea
[
	(type) input
	(type) intermediary
	(type) output
	return (output)
]
(
	(output << (intermediary, intermediary)) f
	(intermediary << input) g
	(input) x
	(input) y
)
{
	return f(g(x), g(y))
}

algorithm PSI
[
	(type) input
	(type) intermediary
	(type) output
	return (output << (input, input))
]
(
	(output << (intermediary, intermediary)) f
	(intermediary << input) g
)
{
	return sea(f, g, -, -)
}



algorithm gold
[
	(type) input
	(type) left-intermediary
	(type) right-intermediary
	(type) output
	return (output)
]
(
	(output << (left-intermediary, right-intermediary)) f
	(left-intermediary << input) g
	(right-intermediary << input) h
	(input) x
)
{
	return f(g(x), h(x))
}

algorithm PHI
[
	(type) input
	(type) left-intermediary
	(type) right-intermediary
	(type) output
	return (output << input)
]
(
	(output << (left-intermediary, right-intermediary)) f
	(left-intermediary << input) g
	(right-intermediary << input) h
)
{
	return gold(f, g, h, -)
}




algorithm d
[
	return (singular)
]
(
	(classical-logic) p
	(singular << singular) t
	(singular << singular) f
)
{
	return p.if(t, f)
}

algorithm cond
[
	return (singular << classical-logic)
]
(
	(singular << singular) t
	(singular << singular) f
)
{
	return classical-logic:if(-, t, f)
}



algorithm convert-mutability
[
	(type) input
	(type) immutable-input = immutable(input)
	(type) arguments
	return (immutable-input)
]
(
	(immutable-input) default
	(singular << (input alias, arguments)) proc
	(arguments) args
)
{
	(input) ret = default
	proc(&ret, args)
	return ret
}

