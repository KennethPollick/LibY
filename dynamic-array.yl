(constant natural) DYNAMIC_ARRAY_DEFAULT_LENGTH = 10

type dynamic-array
[
	(allocator alias) a
	inherit (list)
]
(
	(array subtype) arr
)
{
	(natural) len
	(natural) cap
	(t arr allocation[a]) current
	
	/***
	ctor() { this = ctor(DYNAMIC_ARRAY_DEFAULT_LENGTH); }
	
	ctor(immutable natural length)
	{
		this = {allocate{dt#0 array[length]}, length};
	}
	***/

	algorithm length
	static
	[
		return (natural)
	]
	(
		(THIS) this
	)
	{
		return this.len
	}

	algorithm capacity
	static
	[
		return (natural)
	]
	(
		(THIS) this
	)
	{
		return this.cap
	}



	algorithm index
	static
	[
		return (t alias)
	]
	(
		(THIS) this
		(immutable natural) i
	)
	{
		return (*this.current)[i]
	}

	algorithm map
	static	//currently, the library does not have consistent use of the mutability properties like static
	[
		(type) output
		return (output list)
	]
	(
		(THIS) this
		(output << t) mapping
	)
	{
		(immutable natural) l = this.len
		(dynamic-array) ret = THIS:ctor(l)

		(c[range] <| {0, l}).do <| PHI(output:assign, ret.index, mapping <> this.index)

		return ret
	}
}
