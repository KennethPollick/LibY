(constant natural[]) R_ARRAY_DEFAULT_LENGTH = 10

type r_array
[
	inherit (list)
]
{
	(t array pointer) arr
	(natural[]) len
	
	/***
	ctor() { this = ctor(R_ARRAY_DEFAULT_LENGTH); }
	
	ctor(immutable natural[] length)
	{
		this = {allocate{dt#0 array[length]}, length};
	}
	***/

	algorithm length
	static
	[
		return (natural)
	]
	(
		(THIS) this
	)
	{
		return this.len
	}

	algorithm capacity
	static
	[
		return (natural)
	]
	(
		(THIS) this
	)
	{
		return size{*this.arr}
	}



	algorithm index
	static
	[
		return (t alias)
	]
	(
		(THIS) this
		(immutable natural[]) i
	)
	{
		// TODO: decide whether to bounds check on capacity or length and whether that is only in debug mode
		if (DEBUG)
		{
			if (i >= this.capacity())
				err "capacity of resizable array exceeded";
			else if (i >= this.length())
				err "length of resizable array exceeded";
		}

		return this.arr[i];
	}

	algorithm map
	static	//currently, the library does not have consistent use of the mutability properties like static
	[
		(type) output
		return (output list)
	]
	(
		(THIS) this
		(output << t) proc
	)
	{
		natural[] immutable l = this.len;
		dt#1 r_array ret = ctor(l);

		for (natural[] c = 0; c < l; c++)
			ret[c] = proc(this[c]);

		return ret;
	}
}
