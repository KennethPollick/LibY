//verify interface is complete
//evaluate whether casts here can be avoided
type either
immutable
[
	inherit (sdt)
]
(
	(type) l
	(type) r
)
{
	(boole) left
	(memory[max{SIZE{l}, SIZE{r}}]) buf

	/***
	ctor() { this = {T, {}}; }
	***/

	algorithm on_left
	[
		return (boole)
	]
	(
		(THIS) this
	)
	{
		return this.left
	}

	algorithm get_left
	[
		return (l)
	]
	(
		(THIS) this
	)
	{
		return cast{this.buf, dt#0}
		/* does this need to be a cast; can ctors understand a memory argument by default? */
	}

	algorithm get_right
	[
		return (r)
	]
	(
		(THIS) this
	)
	{
		return cast{this.buf, dt#1}
	}
}



algorithm left
[
	(type) t-left
	(type) t-right
	return ({t-left, t-right} either)
]
(
	(t-left) l
	(t-right) r
)
{
	return {T, cast{l, memory}}
}

algorithm right
[
	(type) t-left
	(type) t-right
	return ({t-left, t-right} either)
]
(
	(t-left) l
	(t-right) r
)
{
	return {F, cast{r, memory}}
}

