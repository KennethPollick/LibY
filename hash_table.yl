type hash_table
[
	(natural) n
	inherit (ndt)
]
(
	(type) input
	(type) output
)
{
	(constant (natural[] << input) immutable pointer) hash_proc
	(output array[n]) outputs		//TODO:rename

	//TODO: decide collision handling method
	//since the hash procedure is constant, this hash table might not need a ctor as a simple array or array of small list optimized linked lists wouldn't violate the definition
	/***
	ctor(constant (natural[] << input) immutable pointer hash_proc) { this.hash_proc = hash_proc; }
	***/

	algorithm index
	[
		return (output alias)
	]
	(
		(THIS) this
		(input) i
	)
	{
		return this.outputs[this.hash_proc(i) % n]
	}
}
