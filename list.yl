type list
[
	inherit (ndt)
]
(
	(type) t
)
{
	algorithm append
	[
		return ()
	]
	(
		(THIS) this
		(t) element
	)

	algorithm index
	static
	[
		return (t alias)
	]
	(
		(THIS) this
		(natural) i
	)
}
