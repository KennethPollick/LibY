type any
[
	inherit (sdt)
]
{
	(dt pointer) thing
	
	/***
	ctor(any a) { this.thing = allocate{*a.thing}; }
	
	ctor(dt v) { this.thing = allocate{v}; }
	
	dtor() { free{this.thing}; }
	***/

	
	
	algorithm exists
	[
		return (boole)
	]
	(
		(THIS) this
	)
	{
		return this.thing ~= NULL
	}
	


	algorithm assign
	[
		(type) input
		return (THIS)
	]
	(
		(THIS alias)
		(immutable input) v
	)
	{
		if (is_type{v, any})
		{
			if (this.thing ~= v.thing)
			{
				if (this.thing ~= NULL)
					this.dtor();
				
				this = ctor(v);
			}
		}
		else
		{
			this = ctor(v);
		}
		
		return this;
	}

	algorithm dereference //might have meant for this to alias the actual value
	[
		return (dt pointer)
	]
	(
		(THIS) this
	)
	{
		return this.thing
	}
}
