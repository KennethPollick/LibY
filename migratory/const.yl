type const
immutable
[
	inherit (sdt)
]
(
	(type) t
)
{
	(t) data

	algorithm dereference
	[
		return (t alias)
	]
	(
		(THIS) this
	)
	{
		return &this.data
	}
}

type really-const
constant
[
	inherit (sdt)
]
(
	(type) t
)
{
	(t) data

	algorithm dereference
	[
		return (t alias)
	]
	(
		(THIS) this
	)
	{
		return &this.data
	}
}

