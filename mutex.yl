//also now going to be part of the language to coincide with the addition of the execution model
type mutex
[
	inherit (sdt)
]
(
	(type) t
)
{
	(t) data
	(natural) pid	//TODO: implementation change
	(boole) using
	
	/***
	/*ctor()
	{
		data = dt();
		pid = 0;
	}*/
	
	ctor(dt initial)
	{
		this = mutex{initial, 0, F};
	}
	***/
	
	
	
	
	
	algorithm wait_lock
	parallel
	(
		(THIS) this
		(natural) my_pid
	)
	{
		while (this.pid ~= my_pid)
		{
			while (this.pid ~= 0) {}
			this.pid = my_pid;
		}
	}
	


	algorithm try_lock
	parallel
	[
		return (boole)
	]
	(
		(THIS) this
		(natural) my_pid
	)
	{
		if (this.pid == 0)
		{
			this.pid = my_pid;
			return (this.pid == my_pid);
		}
		return F;
	}
	


	algorithm unwrap
	[
		return (t)
	]
	(
		(THIS) this
	)
	{
		return this.data
	}
	


	algorithm unlock
	(
		(THIS) this
		(natural) my_pid
	)
	{
		if (this.pid == my_pid)
		{
			this.pid = 0;
			this.using = F;
		}
	}
}
