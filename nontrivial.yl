type nontrivial
[
	inherit (sdt)
]
(
	(type) t
)
{
	(t) data
	(boole) destroy
	
	/***
	//ctor(dt#0 data, boole destroy) { this = {data, destroy}; }

	dtor()
	{
		if (this.destroy)
			this.data.dtor();
	}
	***/

	algorithm unwrap
	[
		return (t)
	]
	(
		(THIS) this
	)
	{
		return this.data
	}
}
