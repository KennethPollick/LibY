type pigeon-holes
[
	(natural) R
	inherit (ndt)
]
(
	(type) t
)
{
	(flags[R]) there
	(t array[8*R]) boxes

	/***
	ctor(dt#0 maybe array[8*R] transform)
	{
		for (natural c = 0; c < 8*R; c++)
			if (this.there[c] = transform[c].exists)
				this.boxes[c] = *transform[c];
	}
	***/



	algorithm clear
	[
		return ()
	]
	(
		(THIS) this
	)
	{
		this.there.clear()
	}

	algorithm transform
	[
		return (t perhaps array[8*R])
	]
	(
		(THIS) this
	)
	{
		dt#0 maybe array[8*R] ret;

		for (natural c = 0; c < 8*R; c++)
		{
			if (this.there[c])
				ret[c] = ctor(this.boxes[c]);
			else
				ret[c] = ctor();
		}

		return ret;
	}
}

