//make sure to switch dt out with a type representing a well ordered set
type range
immutable
[
	inherit (sdt)
]
(
	(type) t
)
{
	(t) low
	(t) length

	/***
	ctor(t low, t length)
	{
		this.low = low;
		this.length = length;
	}
	***/

	algorithm high
	static
	[
		return (t)
	]
	(
		(THIS) this
	)
	{
		return this.low + (this.length - 1)
	}



	algorithm map_sink
	(
		(singular << t) proc
	)
	{
		dt#0 h = this.high();
		for (dt#0 c = this.low; c <= h; c++) proc(c);
	}

	algorithm map
	[
		(type) output
		return (output array)
	]
	(
		(output << t) proc
	)
	{
		dt#0 h = this.high();
		dt#1 array[this.length] arr;
		for (dt#0 c = this.low; c <= h; c++) arr[c-this.low] = proc(c);
	}
}
