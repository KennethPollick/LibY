//needs evaluation
algorithm stream
constant
[
	inherit (sdt)
]
(
	(type) output
	(type) input
)
{
	(output perhaps << input perhaps) filter
	({input, dt} stream pointer) previous

	/***
	//again, maybe ctor is unneeded now
	ctor((dt#0 maybe << dt#1 maybe) filter) { this = {filter, NULL}; }
	***/

	algorithm with_filter
	[
		(type) new-output
		return ({new-ouput, output} stream)
	]
	(
		(THIS) this
		(new-output perhaps << output perhaps) filter
	)
	{
		return stream{filter, &this}
	}

	//maybe make defer property to bubble up failed concrete casts to the call site outside of deferred procedures
	algorithm apply
	[
		return (output perhaps)
	]
	(
		(THIS) this
		(dt perhaps |> immutable) value
	)
	{
		dt#0 maybe out;

		if (this.previous ~= NULL)
		{
			dt#1 maybe in = this.previous.apply(value);
			out = this.filter(in);
		}
		else
		{
			out = this.filter( concrete{cast{value, dt#1 maybe}} );
		}
		
		return out;
	}

	//member procedure that applies to a list
}
