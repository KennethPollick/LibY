type surrogate
[
	(natural) n
	inherit (sdt)
]
(
	(type) t
)
{
	(memory[n]) data
	
	/***
	ctor(dt#0 immutable s)
	{
		if (SIZE{s} > n)
			err "type is too large for surrogate";
		
		this.data = memory(s);
	}
	***/
	


	algorithm broker
	static
	[
		return (t link)
	]
	(
		(THIS) this
	)
	{
		return &this.data
	}

	//check if dereference operator is also necessary
}
