type version
[
	(natural) n
	inherit (sdt)
]
{
	(natural vector[n]) p
	
	algorithm index
	static
	[
		return (natural)
	]
	(
		(THIS) this
		(natural) i
	)
	{
		return this.p[i]
	}

	//TODO: fix inheritance of natural equality
	algorithm assign
	static
	[
		return (THIS)
	]
	(
		(THIS) this
		(THIS) v
	)
	{
		this.p = v.p
	}
}
